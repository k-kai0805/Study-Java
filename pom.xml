<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.khanh</groupId>
    <artifactId>study-java</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Study-Java</name>
    <description>Java learning path: core -&gt; banking backend / payment gateway</description>

    <properties>
        <!-- 'release' thay cho source/target: vừa set JDK, vừa chặn dùng
             API có trong JDK mới hơn mà CI không có. -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Maven mặc định dùng encoding của OS -> build được trên macOS
             nhưng fail trên máy khác. Chốt UTF-8. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <lombok.version>1.18.42</lombok.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <!-- Layout chuan Maven/Spring Boot: src/main/java + src/test/java -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Bat buoc cho JUnit 5. Surefire 2.x chay khong phat hien
                 JUnit Platform. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- BOM: quan ly version JUnit o MOT cho, khai bao dependency
                 o duoi khong can ghi version. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- provided = chi can luc bien dich, khong can luc chay.
              Bat buoc: Account va BankingController dung @Data / @AllArgsConstructor. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Cho buoc "mvn test" trong CI co y nghia. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
